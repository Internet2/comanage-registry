<!--
  While this schema mostly works with database prefixes, foreign key constraints
  must be specified in raw SQL, which needs the prefixed table name.
-->
<schema version="0.3">
  <table name="slip_plugins">
    <field name="id" type="I">
      <key />
      <autoincrement />
    </field>
    <field name="co_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_cos(id)</constraint>
    </field>
    <field name="registrar_co_group_id" type="I">
      <constraint>REFERENCES cm_co_groups(id)</constraint>
    </field>
    <field name="proofing_valid_co_group_id" type="I">
      <constraint>REFERENCES cm_co_groups(id)</constraint>
    </field>
    <field name="proofing_exempt_co_group_id" type="I">
      <constraint>REFERENCES cm_co_groups(id)</constraint>
    </field>
    <field name="initiation_template_id" type="I">
      <constraint>REFERENCES cm_co_message_templates(id)</constraint>
    </field>
    <field name="scheduling_template_id" type="I">
      <constraint>REFERENCES cm_co_message_templates(id)</constraint>
    </field>
    <field name="binding_template_id" type="I">
      <constraint>REFERENCES cm_co_message_templates(id)</constraint>
    </field>
    <field name="vouching_template_id" type="I">
      <constraint>REFERENCES cm_co_message_templates(id)</constraint>
    </field>
    <field name="approval_template_id" type="I">
      <constraint>REFERENCES cm_co_message_templates(id)</constraint>
    </field>
    <field name="created" type="T" />
    <field name="modified" type="T" />
    <field name="slip_plugin_id" type="I">
      <constraint>REFERENCES cm_slip_plugins(id)</constraint>
    </field>
    <field name="revision" type="I" />
    <field name="deleted" type="L" />
    <field name="actor_identifier" type="C" size="256" />

    <index name="slip_plugins_i1">
      <col>co_id</col>
    </index>
  </table>
  
  <table name="slip_proofings">
    <field name="id" type="I">
      <key />
      <autoincrement />
    </field>
    <field name="slip_plugin_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_slip_plugins(id)</constraint>
    </field>
    <field name="co_person_id" type="I">
      <constraint>REFERENCES cm_co_people(id)</constraint>
    </field>
    <field name="initiator_co_person_id" type="I">
      <constraint>REFERENCES cm_co_people(id)</constraint>
    </field>
    <field name="registrar_co_person_id" type="I">
      <constraint>REFERENCES cm_co_people(id)</constraint>
    </field>
    <field name="voucher_co_person_id" type="I">
      <constraint>REFERENCES cm_co_people(id)</constraint>
    </field>
    <field name="status" type="C" size="2" />
    <field name="assignment_time" type="T" />
    <field name="vouch_request_time" type="T" />
    <field name="vouch_time" type="T" />
    <field name="resolution_time" type="T" />
    <field name="created" type="T" />
    <field name="modified" type="T" />
    <field name="slip_proofing_id" type="I">
      <constraint>REFERENCES cm_slip_proofings(id)</constraint>
    </field>
    <field name="revision" type="I" />
    <field name="deleted" type="L" />
    <field name="actor_identifier" type="C" size="256" />

    <index name="slip_proofings_i1">
      <col>slip_plugin_id</col>
    </index>
    <index name="slip_proofings_i2">
      <col>co_person_id</col>
    </index>
    <index name="slip_proofings_i3">
      <col>registrar_co_person_id</col>
    </index>
    <index name="slip_proofings_i4">
      <col>voucher_co_person_id</col>
    </index>
  </table>

  <table name="slip_identity_documents">
    <field name="id" type="I">
      <key />
      <autoincrement />
    </field>
    <field name="slip_proofing_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_slip_proofings(id)</constraint>
    </field>
    <field name="identity_document_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_identity_documents(id)</constraint>
    </field>
    <field name="created" type="T" />
    <field name="modified" type="T" />
    <field name="slip_identity_document_id" type="I">
      <constraint>REFERENCES cm_slip_identity_documents(id)</constraint>
    </field>
    <field name="revision" type="I" />
    <field name="deleted" type="L" />
    <field name="actor_identifier" type="C" size="256" />
    
    <index name="slip_identity_documents_i1">
      <col>slip_proofing_id</col>
    </index>
    <index name="slip_identity_documents_i2">
      <col>identity_document_id</col>
    </index>
  </table>

  <table name="slip_bindings">
    <field name="id" type="I">
      <key />
      <autoincrement />
    </field>
    <field name="slip_proofing_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_slip_proofings(id)</constraint>
    </field>
    <field name="org_identity_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_org_identities(id)</constraint>
    </field>
    <field name="status" type="C" size="2" />
    <field name="authenticated_identifier" type="C" size="256" />
    <field name="code" type="C" size="8" />
    <field name="verification_time" type="T" />
    <field name="created" type="T" />
    <field name="modified" type="T" />
    <field name="slip_binding_id" type="I">
      <constraint>REFERENCES cm_slip_bindings(id)</constraint>
    </field>
    <field name="revision" type="I" />
    <field name="deleted" type="L" />
    <field name="actor_identifier" type="C" size="256" />
    
    <index name="slip_bindings_i1">
      <col>slip_proofing_id</col>
    </index>
    <index name="slip_bindings_i2">
      <col>identity_document_id</col>
    </index>
    <index name="slip_bindings_i3">
      <col>org_identity_id</col>
    </index>
  </table>

  <table name="slip_attachments">
    <field name="id" type="I">
      <key />
      <autoincrement />
    </field>
    <field name="slip_proofing_id" type="I">
      <notnull />
      <constraint>REFERENCES cm_slip_proofings(id)</constraint>
    </field>
    <field name="description" type="C" size="256" />
    <field name="mime_type" type="C" size="256" />
    <field name="file_contents" type="B" />
    <field name="created" type="T" />
    <field name="modified" type="T" />
    
    <index name="slip_bindings_i1">
      <col>slip_proofing_id</col>
    </index>
  </table>
</schema>